# Firebase Admin SDK Configuration
# Can be either:
# 1. A base64-encoded service account JSON
# 2. A raw JSON string
# 3. Just place serviceAccountKey.json in the root directory for local development
FIREBASE_SERVICE_ACCOUNT="your_firebase_service_account_key_here"

# Groq API Key for question generation
# Get this from https://console.groq.com
GROQ_API_KEY="your_groq_api_key_here"

# Server Configuration
PORT=5000
NODE_ENV=production
