// Firestore Security Rules for Dental Care App
// Copy these rules to your Firebase Console -> Firestore Database -> Rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is the dentist
    function isDentist(dentistUid) {
      return isAuthenticated() && request.auth.uid == dentistUid;
    }
    
    // Users collection - users can read/write their own data
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // Patients collection - dentists can only access their own patients
    match /patients/{patientId} {
      allow read: if isAuthenticated() && resource.data.dentistUid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.dentistUid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.dentistUid == request.auth.uid;
      
      // Patient cases subcollection
      match /cases/{caseId} {
        allow read: if isAuthenticated() && get(/databases/$(database)/documents/patients/$(patientId)).data.dentistUid == request.auth.uid;
        allow create: if isAuthenticated() && request.resource.data.dentistUid == request.auth.uid;
        allow update, delete: if isAuthenticated() && resource.data.dentistUid == request.auth.uid;
      }
    }
    
    // Main cases collection - dentists can only access their own cases
    match /cases/{caseId} {
      allow read: if isAuthenticated() && resource.data.dentistUid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.dentistUid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.dentistUid == request.auth.uid;
    }
    
    // Scans collection (if used) - dentists can only access their own scans
    match /scans/{scanId} {
      allow read: if isAuthenticated() && resource.data.dentistUid == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.dentistUid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.dentistUid == request.auth.uid;
    }
    
    // Test collection for connection tests
    match /_test/{testId} {
      allow read, write: if isAuthenticated();
    }
  }
}
