rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Rules for 'users' collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Rules for 'cases' collection - all authenticated users can read, only writers can edit
    match /cases/{caseId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.dentistUid;
    }

    // Rules for 'patients' collection - all authenticated users can read, only writers can edit
    match /patients/{patientId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.dentistUid;
    }

    // Rules for 'quizzes' collection - all authenticated users can read, only writers can edit
    match /quizzes/{quizId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.dentistUid;
    }

    // Rules for 'attempts' collection - students create their own, dentists can read all
    match /attempts/{attemptId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.studentId;
    }

    // Rules for 'lectureNotes' collection - all authenticated users can read, only writers can edit
    match /lectureNotes/{noteId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.dentistUid;
    }

    // Rules for 'prescriptions' collection - all authenticated users can read, only writers can edit
    match /prescriptions/{prescriptionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.dentistUid;
    }

    // Rules for 'scans' collection - all authenticated users can read, only writers can edit
    match /scans/{scanId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.dentistUid;
    }
    
  }
}
